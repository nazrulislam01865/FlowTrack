# FlowTrack Phase 14 horizontal-production profile
# Merge these keys into the real production .env; do not commit secrets.
APP_ENV=production
APP_DEBUG=false
FLOWTRACK_HORIZONTAL_SCALING=true

# Shared Redis/Tair/Valkey. Prefer a managed HA endpoint reachable from every node.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REVERB_SCALING_REDIS_DB=4
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

CACHE_STORE=redis
REDIS_CACHE_CONNECTION=cache
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_STORE=redis-session
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_AFTER_COMMIT=true
REALTIME_QUEUE_CONNECTION=redis
REALTIME_QUEUE=realtime

# Central outbound email module. Business code never changes when an SMTP
# provider changes: update these transport credentials only.
FLOWTRACK_EMAIL_TRANSPORT=laravel
FLOWTRACK_EMAIL_MAILER=smtp
FLOWTRACK_EMAIL_QUEUE_ENABLED=true
FLOWTRACK_EMAIL_QUEUE_CONNECTION=redis
FLOWTRACK_EMAIL_QUEUE=emails
FLOWTRACK_EMAIL_QUEUE_TRIES=100
FLOWTRACK_EMAIL_QUEUE_MAX_EXCEPTIONS=4
FLOWTRACK_EMAIL_QUEUE_TIMEOUT=30
FLOWTRACK_EMAIL_RATE_LIMIT_PER_MINUTE=120
FLOWTRACK_EMAIL_ATTACHMENT_MAX_BYTES=15728640
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_TIMEOUT=10
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="FlowTrack"
# Optional once multiple real mailers are configured in config/mail.php:
# FLOWTRACK_EMAIL_MAILER=failover
# MAIL_FAILOVER_MAILERS=smtp,postmark
# MAIL_FAILOVER_RETRY_AFTER=60

# Reverb processes may run on more than one application node. Redis carries
# cross-server channel state/events; the public load balancer still terminates WSS.
REVERB_SCALING_ENABLED=true
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_API_HOST=127.0.0.1
REVERB_API_PORT=8080
REVERB_API_SCHEME=http

# Shared filesystem profile (NFS/managed shared volume). Mount the same paths
# on every application/worker node before switching FLOWTRACK_HORIZONTAL_SCALING.
FLOWTRACK_PUBLIC_STORAGE_PATH=/srv/flowtrack-shared/public
FLOWTRACK_PRIVATE_STORAGE_PATH=/srv/flowtrack-shared/private
FLOWTRACK_QUARANTINE_STORAGE_PATH=/srv/flowtrack-shared/quarantine
FLOWTRACK_DOCUMENT_DISK=flowtrack_private
FLOWTRACK_QUARANTINE_DISK=flowtrack_quarantine

# Large Order Artwork transport. Three 15MB requests may be in flight for one
# file; keep PHP-FPM/web worker capacity sized for normal concurrent users.
FLOWTRACK_ARTWORK_CHUNK_BYTES=15728640
FLOWTRACK_ARTWORK_CHUNK_CONCURRENCY=3
FLOWTRACK_REQUIRE_SHARED_STORAGE=true
FLOWTRACK_STORAGE_HEALTH_SENTINEL=health/flowtrack-ready.txt

# Optional S3-compatible private documents instead of the shared private mount.
# Requires: composer require league/flysystem-aws-s3-v3
# FLOWTRACK_DOCUMENT_DISK=flowtrack_object
# FLOWTRACK_QUARANTINE_DISK=flowtrack_object_quarantine
# FLOWTRACK_OBJECT_KEY=
# FLOWTRACK_OBJECT_SECRET=
# FLOWTRACK_OBJECT_REGION=
# FLOWTRACK_OBJECT_BUCKET=
# FLOWTRACK_OBJECT_QUARANTINE_BUCKET=
# FLOWTRACK_OBJECT_ENDPOINT=
# FLOWTRACK_OBJECT_PATH_STYLE=false

# Queue/infrastructure monitoring
FLOWTRACK_QUEUE_NAMES=realtime,notifications,emails,default
FLOWTRACK_QUEUE_MAX_DEPTH=100
FLOWTRACK_QUEUE_SLOW_DELAY_SECONDS=15
FLOWTRACK_QUEUE_MONITOR_ENABLED=true
FLOWTRACK_HEALTH_CHECK_STORAGE=true
FLOWTRACK_HEALTH_CHECK_QUEUE=true
FLOWTRACK_HEALTH_EXPOSE_DETAILS=false

# Database process/connection planning. Actual max_connections belongs on the
# MySQL server/managed DB parameter group, not in Laravel.
DB_CONNECT_TIMEOUT=5
FLOWTRACK_EXPECTED_WEB_WORKERS=12
FLOWTRACK_EXPECTED_QUEUE_WORKERS=8
FLOWTRACK_EXPECTED_SCHEDULER_WORKERS=1
FLOWTRACK_DB_CONNECTION_RESERVE=25

# Backups should land on durable shared/off-node storage.
FLOWTRACK_DATABASE_BACKUP_ENABLED=true
FLOWTRACK_DATABASE_BACKUP_DIRECTORY=/srv/flowtrack-shared/backups
FLOWTRACK_DATABASE_BACKUP_RETAIN_DAYS=14
FLOWTRACK_DATABASE_BACKUP_TIME=01:30
FLOWTRACK_MYSQLDUMP_BINARY=mysqldump
FLOWTRACK_MYSQL_BINARY=mysql
