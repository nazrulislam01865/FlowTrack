[program:flowtrack-reverb]
process_name=%(program_name)s
command=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
directory=/var/www/flowtrack
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/log/supervisor/flowtrack-reverb.log
stopwaitsecs=30
