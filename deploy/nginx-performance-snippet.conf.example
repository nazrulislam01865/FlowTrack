# Include inside the HTTPS server block after the normal FlowTrack root/index setup.
#
# Vite emits content-hashed frontend assets under /public/build/assets/.
# Because a changed file receives a new filename, these files are safe to cache
# for one year with the immutable directive.
#
# Do NOT apply the immutable policy to /build/ as a whole: build/manifest.json
# is not content-hashed and must remain able to change between deployments.

# Compress text-based responses before transfer. `gzip_vary` keeps shared
# proxies/CDNs from mixing compressed and uncompressed representations.
gzip on;
gzip_vary on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml
    application/xml+rss
    image/svg+xml;

location ^~ /build/assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    access_log off;
}
