[Unit]
Description=FlowTrack queue worker (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/FlowTracker
ExecStart=/usr/bin/php artisan queue:work redis --queue=%i --sleep=1 --tries=3 --timeout=120 --max-time=3600 --memory=384
Restart=always
RestartSec=3
TimeoutStopSec=150
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
