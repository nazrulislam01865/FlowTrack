# Put these locations inside the SAME HTTPS server block that serves FlowTrack.
# This keeps Reverb on the normal FlowTrack hostname, so no extra DNS name is
# required. Laravel remains responsible for every other URL.

location ^~ /app {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_pass http://127.0.0.1:8080;
}

location ^~ /apps {
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:8080;
}
